# ============================================================
# PecuáriaGest — Configurações de Ambiente
# ============================================================

# Aplicação
APP_NAME=PecuáriaGest
APP_ENV=production
APP_PORT=8080

# Chave para API Mobile (utilizada pelo cabeçalho HTTP-X-API-KEY)
API_KEY=pecuaria-mobile-key

# Segredo de Sessão
SESSION_SECRET=pecuaria_super_secret_session_key_2026

# Credenciais Iniciais do Administrador (criadas no primeiro boot)
DEFAULT_ADMIN_EMAIL=admin@fazenda.com
DEFAULT_ADMIN_PASS=admin123

# Banco de Dados PostgreSQL (Docker / Produção)
POSTGRES_DB=pecuaria
POSTGRES_USER=pecuaria_user
POSTGRES_PASSWORD=pecuaria_pass_2026
DB_HOST=db
DB_PORT=5432
DB_DATABASE=pecuaria
DB_USERNAME=pecuaria_user
DB_PASSWORD=pecuaria_pass_2026
